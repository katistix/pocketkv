# Dashboard login. Both are required. Don't use quotes.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Docker (deploy.sh): host port to publish on, or ip:port. Default 8080.
# Use 127.0.0.1:8080 to only allow access through a local reverse proxy.
# PORT=8080

# Only for `go run` (the container sets these itself):
# ADDR=:8080
# DATA_FILE=data/pocketkv.json
